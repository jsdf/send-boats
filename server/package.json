{
  "name": "send-server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "cd client && npm run build",
    "dev:vite": "cd client && npm run dev",
    "dev:wrangler": "wrangler dev --ip 0.0.0.0 --port 8787 --var DEV_ORIGIN:http://0.0.0.0:8787 2>&1 | tee wrangler-dev.log",
    "dev": "npm-run-all --parallel dev:vite dev:wrangler",
    "preview": "npm run build && wrangler dev --ip 0.0.0.0 --var VITE_DEV_URL: --var DEV_ORIGIN:http://0.0.0.0:8787",
    "deploy": "npm run build && ./scripts/deploy-with-version.sh",
    "start": "npm run dev",
    "test": "vitest",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/kv-asset-handler": "^0.4.0",
    "@cloudflare/vitest-pool-workers": "^0.6.4",
    "@cloudflare/workers-types": "^4.20250204.0",
    "typescript": "^5.5.2",
    "vitest": "2.1.8",
    "wrangler": "^4.14.1"
  }
}